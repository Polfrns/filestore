# Generate one random value >=32 chars and set the same value in Roko api.
ROKO_WORKSPACE_KEY=

WORKSPACE_TTL_MS=1800000
WORKSPACE_SWEEP_MS=60000
WORKSPACE_MAX_BYTES=536870912
WORKSPACE_MAX_FILES=5000
WORKSPACE_GLOBAL_MAX_BYTES=21474836480
WORKSPACE_MAX_UPLOAD_BYTES=104857600
WORKSPACE_MAX_EXEC_PER_USER=2
WORKSPACE_MAX_EXEC_GLOBAL=4
WORKSPACE_OCR_LANG=eng+spa+cat+fra+por+deu+ita

# Optional Langfuse export; runtime tracing settings are documented in DEPLOY.md.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
OBSERVABILITY_TRACE_SECRET=
OBSERVABILITY_CONTENT_MODE=redacted
OBSERVABILITY_CONTENT_MAX_CHARS=4000
