# Copy to .env and fill in values before running docker-compose.
# Never commit .env to git.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string

DB_NAME=leedeo_filestore
DB_USER=postgres
DB_PASSWORD=change-me

# Comma-separated hostnames/IPs the server responds to.
# For a Proxmox VM, this is its LAN IP (e.g. 192.168.1.50).
ALLOWED_HOSTS=localhost,127.0.0.1

# Port to expose on the host (default 8000).
PORT=8000

#==================#
# Langfuse Tracing #
#==================#

# Get Langfuse API keys for your project from the project settings page: https://cloud.langfuse.com

# Optional: if you want to use Langfuse for tracing, fill in the following values.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://IP-DE-LANGFUSE:3000

# Observability v0.7.1 — server configuration only; never send these to models.
# Same random >=32-character value in Roko, Bridge and Filestore. Generate: openssl rand -hex 32
OBSERVABILITY_TRACE_SECRET=
# Roko uses CLAUDE_BRIDGE_KEY to namespace Sessions. Only needed without Bridge:
OBSERVABILITY_SESSION_SECRET=
# Roko only. Explicit authorized service URLs, with scheme, port and base path.
# Example: http://cli-bridge:4000/v1,http://FILESTORE_LAN_IP:8000/mcp
OBSERVABILITY_TRACE_TARGETS=
# Optional safe basenames in Bridge activity and traces; paths/content never exported.
OBSERVABILITY_FILE_NAMES=false
# Use always_on during verification. Parent sampling still applies to received context.
OTEL_TRACES_SAMPLER=always_on
# Prevent the native agents SDK from waiting for export on each response.
LANGFUSE_FORCE_FLUSH_ON_DISPOSE=false

LANGFUSE_TRACING_ENABLED=true

# Observability v0.7.2: export-only policy; restart/recreate the service after changes.
# redacted (default) or debug (bounded conversation text; secrets/binaries still filtered).
OBSERVABILITY_CONTENT_MODE=redacted
# Total text budget per input/output; clamped to 256..16000 characters.
OBSERVABILITY_CONTENT_MAX_CHARS=4000
